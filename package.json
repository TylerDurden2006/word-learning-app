{
  "name": "wordforge",
  "version": "1.0.0",
  "private": true,
  "description": "WordForge vocabulary trainer with AI-generated cards, Google Docs import, and SM-2 spaced repetition.",
  "type": "commonjs",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "migrate:convex": "node scripts/migrate-json-to-convex.mjs",
    "test:core": "node core.test.js",
    "test:convex": "vitest run",
    "test": "npm run test:core && npm run test:convex"
  },
  "dependencies": {
    "convex": "^1.37.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^25.6.0",
    "convex-test": "^0.0.51",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
